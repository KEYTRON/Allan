# Allan Configuration
# Скопируйте этот файл в .env и настройте под ваше окружение

# Пути проекта
ALLAN_PROJECT_PATH=/content/drive/MyDrive/ML_Projects/Allan_Model
ALLAN_CACHE_PATH=/content/allan_cache

# Устройство для вычислений (auto, cpu, cuda, mps)
ALLAN_DEVICE=auto

# Hugging Face
HF_HOME=/content/huggingface_cache
HF_TOKEN=your_hf_token_here

# Логирование
ALLAN_LOG_LEVEL=INFO

# Google Colab (автоматически устанавливается в Colab)
# COLAB_GPU=true
