<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd (macOS): cp deploy/allan-serve.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/allan-serve.plist
     Токен берётся из Keychain (его кладёт `allan connect`). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>prime.allan.serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/keytron/git/Allan/agent/bin/allan</string>
        <string>serve</string>
        <string>--listen</string>
        <string>127.0.0.1:8790</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/allan-serve.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/allan-serve.log</string>
</dict>
</plist>
