#!/bin/sh
# Автозапуск воркера без systemd и без root: ярлык в автозагрузке рабочего стола.
#
#   cp deploy/allan-serve.desktop ~/.config/autostart/
#   chmod +x ~/.local/bin/allan-serve-start
#
# Подходит любому DE/WM, который умеет автозапуск (KDE, GNOME, XFCE, …).
# Процесс остаётся в фоне пользователя и не требует sudo.
exec "$HOME/git/Allan/agent/bin/allan" serve --foreground \
    >> "$HOME/.allan/serve.log" 2>&1
