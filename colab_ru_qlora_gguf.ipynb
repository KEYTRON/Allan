#!/usr/bin/env python3
"""
🚀 Allan - Дообучение русскоязычной LLM с QLoRA и экспорт в GGUF

Этот скрипт предназначен для дообучения современных языковых моделей 
на русском языке с использованием QLoRA (Quantized Low-Rank Adaptation) 
и последующего экспорта в формат GGUF для использования в Ollama.

Возможности:
- Дообучение моделей Qwen2.5, Llama, Mistral на русском языке
- Использование QLoRA для экономии памяти
- Автоматическое сохранение чекпоинтов
- Экспорт в GGUF формат
- Поддержка различных форматов датасетов
"""

import os
import sys
import json
import torch
import subprocess
from pathlib import Path
from typing import Optional, Dict, Any

# Проверка Google Colab
try:
    import google.colab
    IN_COLAB = True
    print("✅ Google Colab обнаружен")
except ImportError:
    IN_COLAB = False
    print("❌ Этот скрипт предназначен для Google Colab")

def setup_environment():
    """Настройка окружения"""
    print("\n🔧 Настройка окружения...")
    
    # Установка зависимостей
    packages = [
        "transformers", "datasets", "accelerate", "peft", "trl", 
        "bitsandbytes", "torch", "sentencepiece", "protobuf"
    ]
    
    for package in packages:
        try:
            print(f"  📦 Установка {package}...")
            subprocess.run([
                sys.executable, "-m", "pip", "install", "-q", package
            ], check=True, capture_output=True)
            print(f"  ✅ {package} установлен")
        except subprocess.CalledProcessError:
            print(f"  ⚠️  {package} уже установлен или ошибка установки")
    
    # Импорт библиотек
    global AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig
    global LoraConfig, PeftModel, SFTTrainer, TrainingArguments
    global load_dataset, Dataset
    
    try:
        from transformers import (
            AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig,
            TrainingArguments
        )
        from peft import LoraConfig, PeftModel, get_peft_model
        from trl import SFTTrainer
        from datasets import load_dataset, Dataset
        print("✅ Все библиотеки импортированы")
    except ImportError as e:
        print(f"❌ Ошибка импорта: {e}")
        return False
    
    return True

def mount_google_drive():
    """Подключение Google Drive"""
    if not IN_COLAB:
        print("⚠️  Google Drive доступен только в Colab")
        return False
    
    print("\n🔗 Подключение Google Drive...")
    try:
        from google.colab import drive
        drive.mount('/content/drive')
        print("✅ Google Drive подключен")
        return True
    except Exception as e:
        print(f"❌ Ошибка подключения Drive: {e}")
        return False

def create_project_structure():
    """Создание структуры проекта"""
    print("\n📁 Создание структуры проекта...")
    
    # Базовые пути
    base_dir = Path('/content/drive/MyDrive/ML_Projects/Allan_Model')
    directories = [
        base_dir / 'datasets',
        base_dir / 'models',
        base_dir / 'checkpoints',
        base_dir / 'models' / 'gguf',
        base_dir / 'models' / 'merged'
    ]
    
    for dir_path in directories:
        dir_path.mkdir(parents=True, exist_ok=True)
        print(f"  📂 Создана папка: {dir_path}")
    
    return base_dir

def load_dataset_from_source(dataset_source: str, datasets_dir: Path):
    """Загрузка датасета из различных источников"""
    print(f"\n📊 Загрузка датасета: {dataset_source}")
    
    try:
        if dataset_source.startswith(('http', 'https', 'hf://')):
            # Hugging Face датасет
            dataset = load_dataset(dataset_source)
            print(f"✅ Датасет загружен с Hugging Face: {dataset}")
        elif (datasets_dir / dataset_source).exists():
            # Локальный файл
            file_path = datasets_dir / dataset_source
            if file_path.suffix == '.jsonl':
                data = []
                with open(file_path, 'r', encoding='utf-8') as f:
                    for line in f:
                        if line.strip():
                            data.append(json.loads(line))
                dataset = Dataset.from_list(data)
                print(f"✅ Локальный JSONL датасет загружен: {len(data)} примеров")
            else:
                print(f"❌ Неподдерживаемый формат файла: {file_path.suffix}")
                return None
        else:
            print(f"❌ Источник датасета не найден: {dataset_source}")
            return None
        
        return dataset
        
    except Exception as e:
        print(f"❌ Ошибка загрузки датасета: {e}")
        return None

def format_dataset_for_training(dataset, format_type: str = "auto"):
    """Форматирование датасета для обучения"""
    print("\n🔧 Форматирование датасета...")
    
    def format_instruction(example):
        """Форматирование данных в инструкцию"""
        if 'messages' in example:
            # Формат messages
            messages = example['messages']
            text = ""
            for msg in messages:
                if msg['role'] == 'user':
                    text += f"<|user|>\n{msg['content']}\n<|assistant|>\n"
                elif msg['role'] == 'assistant':
                    text += f"{msg['content']}\n"
            return text
        elif 'instruction' in example:
            # Формат instruction/input/output
            instruction = example['instruction']
            input_text = example.get('input', '')
            output = example.get('output', '')
            
            if input_text:
                text = f"<|user|>\n{instruction}\n\n{input_text}\n<|assistant|>\n{output}"
            else:
                text = f"<|user|>\n{instruction}\n<|assistant|>\n{output}"
            return text
        else:
            # Простой текст
            return f"<|user|>\n<|assistant|>\n{example.get('text', '')}"
    
    try:
        formatted_dataset = dataset.map(format_instruction)
        print("✅ Датасет отформатирован")
        
        # Показываем пример
        if len(formatted_dataset) > 0:
            example = formatted_dataset[0]['text'][:200] + "..." if len(formatted_dataset[0]['text']) > 200 else formatted_dataset[0]['text']
            print(f"📝 Пример форматированных данных: {example}")
        
        return formatted_dataset
        
    except Exception as e:
        print(f"❌ Ошибка форматирования: {e}")
        return None

def setup_model_and_tokenizer(base_model: str, use_4bit: bool = True):
    """Настройка модели и токенизатора"""
    print(f"\n🤖 Настройка модели: {base_model}")
    
    try:
        # Загрузка токенизатора
        print("📥 Загрузка токенизатора...")
        tokenizer = AutoTokenizer.from_pretrained(
            base_model,
            trust_remote_code=True,
            padding_side="right"
        )
        
        # Устанавливаем pad_token если его нет
        if tokenizer.pad_token is None:
            tokenizer.pad_token = tokenizer.eos_token
        
        # Настройка квантизации
        if use_4bit:
            print("🔧 Настройка 4-бит квантизации...")
            bnb_config = BitsAndBytesConfig(
                load_in_4bit=True,
                bnb_4bit_quant_type="nf4",
                bnb_4bit_compute_dtype=torch.float16,
                bnb_4bit_use_double_quant=False,
            )
        else:
            bnb_config = None
        
        # Загрузка модели
        print("📥 Загрузка модели...")
        model = AutoModelForCausalLM.from_pretrained(
            base_model,
            quantization_config=bnb_config,
            device_map="auto",
            trust_remote_code=True,
            torch_dtype=torch.float16
        )
        
        print("✅ Модель и токенизатор загружены!")
        return model, tokenizer
        
    except Exception as e:
        print(f"❌ Ошибка загрузки модели: {e}")
        return None, None

def setup_lora(model, lora_config: Optional[Dict[str, Any]] = None):
    """Настройка LoRA"""
    print("\n🎯 Настройка LoRA...")
    
    if lora_config is None:
        lora_config = {
            "r": 16,                     # Ранг адаптации
            "lora_alpha": 32,            # Альфа параметр
            "target_modules": ["q_proj", "v_proj"],  # Целевые модули
            "lora_dropout": 0.05,        # Dropout для LoRA
            "bias": "none",              # Обработка bias
            "task_type": "CAUSAL_LM"     # Тип задачи
        }
    
    try:
        lora_config_obj = LoraConfig(**lora_config)
        
        print("🔧 Применение LoRA к модели...")
        model = get_peft_model(model, lora_config_obj)
        model.print_trainable_parameters()
        
        print("✅ LoRA настроен!")
        return model
        
    except Exception as e:
        print(f"❌ Ошибка настройки LoRA: {e}")
        return None

def setup_training_arguments(checkpoints_dir: Path, **kwargs):
    """Настройка параметров обучения"""
    print("\n🧠 Настройка параметров обучения...")
    
    # Параметры по умолчанию
    default_args = {
        "output_dir": str(checkpoints_dir),
        "num_train_epochs": 3,
        "per_device_train_batch_size": 2,
        "gradient_accumulation_steps": 4,
        "gradient_checkpointing": True,
        "learning_rate": 2e-4,
        "logging_steps": 10,
        "save_steps": 500,
        "eval_steps": 500,
        "warmup_steps": 100,
        "max_seq_length": 2048,
        "fp16": True,
        "optim": "paged_adamw_8bit",
        "lr_scheduler_type": "cosine",
        "report_to": None,
        "save_total_limit": 3,
        "load_best_model_at_end": True,
        "metric_for_best_model": "eval_loss",
        "greater_is_better": False,
    }
    
    # Обновляем параметры по умолчанию
    default_args.update(kwargs)
    
    try:
        training_args = TrainingArguments(**default_args)
        print("✅ Параметры обучения настроены!")
        return training_args
        
    except Exception as e:
        print(f"❌ Ошибка настройки параметров: {e}")
        return None

def find_latest_checkpoint(checkpoints_dir: Path):
    """Поиск последнего чекпоинта"""
    print("\n🔍 Поиск существующих чекпоинтов...")
    
    latest_ckpt = None
    if checkpoints_dir.exists():
        # Ищем последний checkpoint-xxxx
        subdirs = [p for p in checkpoints_dir.glob('checkpoint-*') if p.is_dir()]
        if subdirs:
            latest_ckpt = str(sorted(subdirs, key=lambda p: int(p.name.split('-')[-1]))[-1])
            print(f"✅ Найден чекпоинт: {latest_ckpt}")
        else:
            print("📁 Чекпоинты не найдены, начинаем с нуля")
    else:
        print("📁 Папка чекпоинтов не найдена")
    
    return latest_ckpt

def train_model(model, tokenizer, formatted_dataset, training_args, latest_ckpt: Optional[str] = None):
    """Обучение модели"""
    print(f"\n🚀 Начинаем обучение с: {latest_ckpt if latest_ckpt else 'начала'}")
    
    try:
        # Создаем тренер
        print("🔧 Создание тренера...")
        trainer = SFTTrainer(
            model=model,
            train_dataset=formatted_dataset,
            tokenizer=tokenizer,
            args=training_args,
            max_seq_length=2048,
            dataset_text_field="text",
        )
        
        print("🚀 Запуск обучения...")
        print("⚠️  Это может занять от 30 минут до нескольких часов!\n")
        
        # Запускаем обучение
        trainer.train(resume_from_checkpoint=latest_ckpt if latest_ckpt else None)
        
        print("\n✅ Обучение завершено!")
        return trainer
        
    except Exception as e:
        print(f"❌ Ошибка обучения: {e}")
        return None

def save_lora_adapters(trainer, checkpoints_dir: Path):
    """Сохранение LoRA адаптеров"""
    print("\n💾 Сохранение LoRA адаптеров...")
    
    try:
        lora_adapters_path = checkpoints_dir / 'lora_adapters'
        lora_adapters_path.mkdir(exist_ok=True)
        
        # Сохраняем только LoRA адаптеры (они маленькие)
        trainer.model.save_pretrained(str(lora_adapters_path))
        trainer.tokenizer.save_pretrained(str(lora_adapters_path))
        
        print(f"✅ LoRA адаптеры сохранены в: {lora_adapters_path}")
        return lora_adapters_path
        
    except Exception as e:
        print(f"❌ Ошибка сохранения LoRA адаптеров: {e}")
        return None

def merge_lora_model(base_model: str, lora_adapters_path: Path, merged_dir: Path):
    """Слияние LoRA в полную модель"""
    print("\n🔄 Слияние LoRA в полную модель...")
    
    try:
        # Загружаем базовую модель в fp16 (без 4-бит) для мерджа
        print("📥 Загрузка базовой модели для слияния...")
        base_merge_model = AutoModelForCausalLM.from_pretrained(
            base_model,
            torch_dtype=torch.float16,
            device_map='auto',
            trust_remote_code=True,
        )
        
        print("🔗 Применение LoRA адаптеров...")
        peft_model = PeftModel.from_pretrained(
            base_merge_model,
            str(lora_adapters_path),
        )
        
        print("🔄 Слияние адаптеров...")
        merged_model = peft_model.merge_and_unload()
        
        print("💾 Сохранение объединенной модели...")
        merged_model.save_pretrained(str(merged_dir), safe_serialization=True)
        
        print(f"✅ Объединенная модель сохранена в: {merged_dir}")
        return True
        
    except Exception as e:
        print(f"❌ Ошибка слияния LoRA: {e}")
        return False

def convert_to_gguf(merged_dir: Path, gguf_dir: Path, base_dir: Path):
    """Конвертация в GGUF формат"""
    print("\n🐪 Конвертация в GGUF формат...")
    
    try:
        # Настройка llama.cpp
        llamacpp_dir = base_dir / 'llama.cpp'
        if not llamacpp_dir.exists():
            print("📥 Клонирование llama.cpp...")
            subprocess.run([
                "git", "clone", "-q", "https://github.com/ggerganov/llama.cpp", str(llamacpp_dir)
            ], check=True)
        else:
            print("✅ llama.cpp уже установлен")
        
        # Устанавливаем зависимости для конвертера
        print("📦 Установка зависимостей для конвертера...")
        subprocess.run([
            sys.executable, "-m", "pip", "install", "-q", "numpy==1.26.4"
        ], check=True)
        
        # Конвертация в GGUF
        print("🔧 Конвертация в GGUF...")
        convert_script = llamacpp_dir / 'convert-hf-to-gguf.py'
        outfile_base = gguf_dir / 'qwen2.5-1_5b-instruct-finetuned'
        
        subprocess.run([
            sys.executable, str(convert_script),
            "--outtype", "f16",
            "--outfile", f"{outfile_base}.f16.gguf",
            str(merged_dir)
        ], check=True)
        
        print("✅ Конвертация в GGUF завершена!")
        return f"{outfile_base}.f16.gguf"
        
    except Exception as e:
        print(f"❌ Ошибка конвертации в GGUF: {e}")
        return None

def quantize_gguf(gguf_file: str, base_dir: Path):
    """Квантизация GGUF файла"""
    print("\n📊 Квантизация GGUF файла...")
    
    try:
        llamacpp_dir = base_dir / 'llama.cpp'
        quantize_bin = llamacpp_dir / 'quantize'
        
        # Сборка llama.cpp если нужно
        if not (llamacpp_dir / 'build').exists():
            print("🔨 Сборка llama.cpp...")
            os.chdir(llamacpp_dir)
            subprocess.run([
                "mkdir", "-p", "build"
            ], check=True)
            
            subprocess.run([
                "cmake", "-S", ".", "-B", "build", 
                "-DGGML_METAL=OFF", "-DGGML_OPENBLAS=ON", 
                "-DCMAKE_BUILD_TYPE=Release"
            ], check=True)
            
            subprocess.run([
                "cmake", "--build", "build", "-j", "2"
            ], check=True)
            
            os.chdir("/content")
            print("✅ Сборка завершена!")
        else:
            print("✅ llama.cpp уже собран")
        
        # Квантизация в Q4_K_M
        print("🔧 Квантизация в Q4_K_M...")
        outfile_base = str(gguf_file).replace('.f16.gguf', '')
        
        subprocess.run([
            str(llamacpp_dir / 'build' / 'bin' / 'quantize'),
            f"{outfile_base}.f16.gguf",
            f"{outfile_base}.Q4_K_M.gguf",
            "Q4_K_M"
        ], check=True)
        
        print(f"✅ GGUF файл записан: {outfile_base}.Q4_K_M.gguf")
        return f"{outfile_base}.Q4_K_M.gguf"
        
    except Exception as e:
        print(f"❌ Ошибка квантизации: {e}")
        return None

def main():
    """Основная функция"""
    print("🚀 Allan - Дообучение русскоязычной LLM с QLoRA")
    print("=" * 60)
    
    # Проверка окружения
    if not IN_COLAB:
        print("❌ Этот скрипт предназначен для Google Colab")
        return
    
    # Настройка окружения
    if not setup_environment():
        print("❌ Не удалось настроить окружение")
        return
    
    # Подключение Google Drive
    if not mount_google_drive():
        print("❌ Не удалось подключить Google Drive")
        return
    
    # Создание структуры проекта
    base_dir = create_project_structure()
    
    # Конфигурация
    config = {
        "base_model": "Qwen/Qwen2.5-1.5B-Instruct",
        "dataset_source": "IlyaGusev/saiga_qa",  # Или путь к вашему JSONL файлу
        "use_4bit": True,
        "training_epochs": 3,
        "batch_size": 2,
        "max_seq_length": 2048
    }
    
    print(f"\n⚙️ Конфигурация:")
    for key, value in config.items():
        print(f"  {key}: {value}")
    
    # Загрузка датасета
    dataset = load_dataset_from_source(config["dataset_source"], base_dir / "datasets")
    if dataset is None:
        print("❌ Не удалось загрузить датасет")
        return
    
    # Форматирование датасета
    formatted_dataset = format_dataset_for_training(dataset)
    if formatted_dataset is None:
        print("❌ Не удалось отформатировать датасет")
        return
    
    # Настройка модели и токенизатора
    model, tokenizer = setup_model_and_tokenizer(config["base_model"], config["use_4bit"])
    if model is None or tokenizer is None:
        print("❌ Не удалось настроить модель")
        return
    
    # Настройка LoRA
    model = setup_lora(model)
    if model is None:
        print("❌ Не удалось настроить LoRA")
        return
    
    # Настройка параметров обучения
    training_args = setup_training_arguments(
        base_dir / "checkpoints",
        num_train_epochs=config["training_epochs"],
        per_device_train_batch_size=config["batch_size"],
        max_seq_length=config["max_seq_length"]
    )
    if training_args is None:
        print("❌ Не удалось настроить параметры обучения")
        return
    
    # Поиск чекпоинта
    latest_ckpt = find_latest_checkpoint(base_dir / "checkpoints")
    
    # Обучение модели
    trainer = train_model(model, tokenizer, formatted_dataset, training_args, latest_ckpt)
    if trainer is None:
        print("❌ Не удалось обучить модель")
        return
    
    # Сохранение LoRA адаптеров
    lora_path = save_lora_adapters(trainer, base_dir / "checkpoints")
    if lora_path is None:
        print("❌ Не удалось сохранить LoRA адаптеры")
        return
    
    # Слияние LoRA в полную модель
    if not merge_lora_model(config["base_model"], lora_path, base_dir / "models" / "merged"):
        print("❌ Не удалось объединить LoRA модель")
        return
    
    # Конвертация в GGUF
    gguf_file = convert_to_gguf(
        base_dir / "models" / "merged",
        base_dir / "models" / "gguf",
        base_dir
    )
    if gguf_file is None:
        print("❌ Не удалось конвертировать в GGUF")
        return
    
    # Квантизация GGUF
    quantized_file = quantize_gguf(gguf_file, base_dir)
    if quantized_file is None:
        print("❌ Не удалось квантизировать GGUF")
        return
    
    print("\n🎉 Обучение и конвертация завершены!")
    print(f"📁 Квантизированная модель: {quantized_file}")
    print("\n🍎 Для использования в Ollama:")
    print("1. Скачайте GGUF файл с Google Drive")
    print("2. Создайте Modelfile рядом с файлом")
    print("3. Выполните: ollama create ru-qlora -f Modelfile")
    print("4. Запустите: ollama run ru-qlora")

if __name__ == "__main__":
    main()
